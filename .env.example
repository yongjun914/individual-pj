# 이 파일을 복사해 .env.local을 만들고 값을 채우세요. (.env.local은 git에 올라가지 않습니다)
# Supabase 대시보드 > Project Settings > API 에서 확인

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- 선택 (없어도 앱은 동작) : 서버 전용 비밀값, 절대 NEXT_PUBLIC_ 을 붙이지 마세요 ----

# 카카오디벨로퍼스 > 앱 > 어드민 키
# 회원 탈퇴 시 카카오 '연결 끊기'와 카카오 '연결 해제' 웹훅 확인에 씁니다.
KAKAO_ADMIN_KEY=

# Supabase 대시보드 > Project Settings > API Keys > Secret key (sb_secret_...)
# 카카오 '연결 해제' 웹훅(/api/kakao/unlink)에서만 씁니다.
SUPABASE_SECRET_KEY=
